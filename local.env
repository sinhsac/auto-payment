# Optional Elasticsearch product backend (leave empty to use the built-in demo catalog)
NUXT_ELASTICSEARCH_BASE_URL=
NUXT_ELASTICSEARCH_TOKEN=

# Offline EMVCo / Bank account configuration (NAPAS 247 BIN codes: 970436=VCB, 970422=MBBank, 970407=Techcombank, 970416=ACB, 970418=BIDV, 970432=VPBank)
NUXT_BANK_BIN=970436
NUXT_BANK_NAME=Vietcombank
NUXT_BANK_ACCOUNT_NO=0123456789
NUXT_BANK_ACCOUNT_NAME=AUTO PAYMENT DEMO
NUXT_ORDER_PREFIX=AP
NUXT_ORDER_EXPIRY_MINUTES=15

# Mirror public bank display fields
NUXT_PUBLIC_BANK_NAME=Vietcombank
NUXT_PUBLIC_BANK_ACCOUNT_NO=0123456789
NUXT_PUBLIC_BANK_ACCOUNT_NAME=AUTO PAYMENT DEMO

# Optional webhook secret for POST /api/webhooks/bank-notify (leave empty for local testing)
NUXT_WEBHOOK_SECRET=

# Set to false in production to hide the 1-click demo payment simulator button
NUXT_PUBLIC_ENABLE_DEMO_SIMULATOR=true
